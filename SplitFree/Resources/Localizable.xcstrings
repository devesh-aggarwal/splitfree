    },
    "Their phone has to be able to reach what the two of you share, which means it has to live somewhere you can both get to.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät der anderen Person muss erreichen können, was ihr teilt, also muss es an einem Ort liegen, den ihr beide erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su teléfono tiene que poder acceder a lo que compartís, así que debe estar en un lugar al que ambos podáis llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur téléphone doit pouvoir accéder à ce que vous partagez, cela doit donc se trouver quelque part où vous pouvez tous les deux le joindre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनका फ़ोन उस तक पहुँच सके जो आप दोनों साझा करते हैं, इसके लिए इसे ऐसी जगह होना चाहिए जहाँ आप दोनों पहुँच सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il loro telefono deve poter raggiungere ciò che condividete, quindi deve trovarsi in un posto accessibile a entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の端末が二人で共有しているものに接続できる必要があるため、二人ともアクセスできる場所に置く必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone dela precisa conseguir acessar o que vocês compartilham, então isso precisa ficar em algum lugar que os dois alcancem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的手机需要能访问你们共享的内容，因此它必须存放在你们双方都能访问的地方。"
          }
        }
      }
    },
    "There's nothing to pay. Nice work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts zu zahlen. Gut gemacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que pagar. Bien hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à payer. Bien joué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी देना बाकी नहीं। बढ़िया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nulla da pagare. Ottimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払うものはありません。お見事。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada a pagar. Muito bem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要支付的款项，很棒。"
          }
        }
      }
    },
    "This build isn't set up for syncing.": {
      "extractionState": "manual",
      "localizations": {
