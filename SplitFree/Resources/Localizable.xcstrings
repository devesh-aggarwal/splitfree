    "Groups keep a trip, a flat, or a running tab in one place. Everyone's balance updates as you add expenses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen bündeln eine Reise, eine WG oder eine laufende Rechnung an einem Ort. Die Salden aller aktualisieren sich mit jeder Ausgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos reúnen un viaje, un piso o una cuenta continua en un solo sitio. El saldo de cada persona se actualiza al añadir gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes rassemblent un voyage, une colocation ou une ardoise au même endroit. Le solde de chacun se met à jour à chaque dépense."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह किसी यात्रा, फ़्लैट या चलते हिसाब को एक जगह रखते हैं। खर्च जोड़ते ही सबका हिसाब अपडेट हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi raccolgono un viaggio, una casa condivisa o un conto aperto in un unico posto. Il saldo di ognuno si aggiorna man mano che aggiungi spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは旅行やシェアハウス、続いているツケを1か所にまとめます。支出を追加すると全員の残高が更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos reúnem uma viagem, um apartamento ou uma conta corrente em um só lugar. O saldo de cada um se atualiza conforme você adiciona despesas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组把一次旅行、一套合租房或一笔长期账目集中在一起。每添加一笔支出，所有人的余额都会更新。"
          }
        }
      }
    },
