    "Your friend's phone has to be able to reach this group, which means it has to live somewhere both of you can get to.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät deiner Freundin oder deines Freundes muss diese Gruppe erreichen können, also muss sie an einem Ort liegen, den ihr beide erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono de tu amigo tiene que poder acceder a este grupo, así que debe estar en un lugar al que ambos podáis llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone de votre ami doit pouvoir accéder à ce groupe, il doit donc se trouver quelque part où vous pouvez tous les deux le joindre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मित्र का फ़ोन इस समूह तक पहुँच सके, इसके लिए इसे ऐसी जगह होना चाहिए जहाँ आप दोनों पहुँच सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono del tuo amico deve poter raggiungere questo gruppo, quindi deve trovarsi in un posto accessibile a entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達の端末からこのグループに接続できる必要があるため、二人ともアクセスできる場所に置く必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone do seu amigo precisa conseguir acessar este grupo, então ele precisa ficar em algum lugar que os dois alcancem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友的手机需要能访问这个群组，因此它必须存放在你们双方都能访问的地方。"
          }
        }
      }
    },
    "Your groups": {
      "extractionState": "manual",
      "localizations": {
