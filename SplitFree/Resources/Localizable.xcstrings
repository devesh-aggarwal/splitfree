    "Individual expenses can be in any of 150+ currencies — this is just the one your totals are shown in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gasto puede estar en cualquiera de las 150+ monedas; esta es solo la moneda en la que se muestran tus totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dépense peut être dans l'une des 150+ devises ; celle-ci sert uniquement à afficher vos totaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelne Ausgaben können in jeder der 150+ Währungen sein – dies ist nur die Währung, in der deine Summen angezeigt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni spesa può essere in una qualsiasi delle 150+ valute: questa serve solo per mostrare i tuoi totali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada despesa pode estar em qualquer uma das 150+ moedas; esta é só a moeda em que seus totais aparecem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खर्च 150+ में से किसी भी मुद्रा में हो सकता है — यह सिर्फ़ वह मुद्रा है जिसमें आपका कुल जोड़ दिखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個々の支出は150+通貨のどれでも使えます。これは合計を表示するときの通貨です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔支出都可以使用 150+ 种货币中的任意一种，这里设置的只是汇总时显示的货币。"
          }
        }
      }
    },
