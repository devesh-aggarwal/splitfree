        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirse a un grupo compartido requiere una cuenta, para que el grupo sepa quién eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre un groupe partagé nécessite un compte, pour que le groupe sache qui vous êtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा समूह में शामिल होने के लिए खाता चाहिए, ताकि समूह जान सके कि आप कौन हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per unirti a un gruppo condiviso serve un account, così il gruppo sa chi sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有グループに参加するにはアカウントが必要です。グループがあなたを識別できるようにするためです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar em um grupo compartilhado exige uma conta, para que o grupo saiba quem você é."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入共享群组需要账户，这样群组才知道你是谁。"
          }
        }
      }
    },
