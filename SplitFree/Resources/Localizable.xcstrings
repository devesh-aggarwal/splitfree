    "Recurring expenses are created when you open SplitFree, dated correctly even if you were away for weeks.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos recurrentes se crean al abrir SplitFree, con la fecha correcta aunque hayas estado semanas sin entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses récurrentes sont créées à l'ouverture de SplitFree, à la bonne date même après plusieurs semaines d'absence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Ausgaben werden beim Öffnen von SplitFree erstellt – mit dem richtigen Datum, auch wenn du wochenlang weg warst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese ricorrenti vengono create all'apertura di SplitFree, con la data giusta anche se sei stato via per settimane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas recorrentes são criadas quando você abre o SplitFree, com a data certa mesmo depois de semanas sem entrar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवर्ती खर्च तब बनते हैं जब आप SplitFree खोलते हैं — तारीख सही रहती है, चाहे आप हफ़्तों दूर रहे हों।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの支出は SplitFree を開いたときに作成されます。何週間空いても日付は正しく入ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周期性支出会在你打开 SplitFree 时创建，即便你几周没打开，日期也会正确。"
          }
        }
      }
    },
