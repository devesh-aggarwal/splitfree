    "Add the people you split with. You can settle up with them directly, without a group.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Personen hinzu, mit denen du teilst. Du kannst direkt mit ihnen abrechnen, ganz ohne Gruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a las personas con las que compartes gastos. Puedes saldar cuentas directamente, sin crear un grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les personnes avec qui vous partagez. Vous pouvez régler vos comptes directement, sans groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनके साथ आप खर्च बाँटते हैं उन्हें जोड़ें। बिना समूह बनाए भी उनसे सीधे हिसाब बराबर कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le persone con cui dividi le spese. Puoi saldare i conti direttamente, senza un gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り勘する相手を追加しましょう。グループを作らなくても直接精算できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as pessoas com quem você divide despesas. Dá para acertar as contas direto, sem criar um grupo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一起分摊的人加进来。不用建群组，也可以直接和他们结账。"
          }
        }
      }
    },
