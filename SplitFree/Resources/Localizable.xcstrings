    "Everyone in this group can see every expense in it, including the ones you add.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas de este grupo pueden ver todos sus gastos, incluidos los que añadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes de ce groupe voient toutes ses dépenses, y compris celles que vous ajoutez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle in dieser Gruppe sehen jede Ausgabe darin, auch die, die du hinzufügst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti in questo gruppo possono vedere ogni spesa, comprese quelle che aggiungi tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas deste grupo veem todas as despesas nele, inclusive as que você adicionar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समूह के सभी लोग इसके हर खर्च को देख सकते हैं, जो आप जोड़ते हैं वे भी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループの全員が、あなたが追加したものも含め、すべての支出を見られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组中的所有人都能看到其中的每一笔支出，包括你添加的。"
          }
        }
