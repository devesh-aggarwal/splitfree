    "Add each line from the bill, then tap the people who shared it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge jede Position der Rechnung hinzu und tippe auf die Personen, die sie geteilt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cada línea de la cuenta y toca a quienes la compartieron."
