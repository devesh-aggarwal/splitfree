    "Export a CSV from your bank or card app, then pick it here. SplitFree reads it on your device — nothing is uploaded anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta un CSV desde la app de tu banco o tarjeta y selecciónalo aquí. SplitFree lo lee en tu dispositivo: no se sube nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez un CSV depuis l'application de votre banque ou de votre carte, puis sélectionnez-le ici. SplitFree le lit sur votre appareil : rien n'est envoyé nulle part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere eine CSV aus deiner Bank- oder Karten-App und wähle sie hier aus. SplitFree liest sie auf deinem Gerät – nichts wird irgendwohin hochgeladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta un CSV dall'app della tua banca o della carta, poi selezionalo qui. SplitFree lo legge sul tuo dispositivo: non viene caricato da nessuna parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte um CSV do app do seu banco ou cartão e selecione-o aqui. O SplitFree lê tudo no seu dispositivo: nada é enviado para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बैंक या कार्ड ऐप से CSV निर्यात करें और यहाँ चुनें। SplitFree उसे आपके डिवाइस पर ही पढ़ता है — कहीं कुछ अपलोड नहीं होता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行やカードのアプリからCSVを書き出し、ここで選んでください。SplitFree は端末上で読み取るだけで、どこにもアップロードしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从银行或信用卡 App 导出 CSV，再在这里选择。SplitFree 只在你的设备上读取，不会上传到任何地方。"
          }
        }
      }
    },
