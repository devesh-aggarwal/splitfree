    "Joining a shared group needs an account, so the group knows who you are.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirse a un grupo compartido requiere una cuenta, para que el grupo sepa quién eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre un groupe partagé nécessite un compte, pour que le groupe sache qui vous êtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einer geteilten Gruppe beizutreten, brauchst du ein Konto, damit die Gruppe weiß, wer du bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per unirti a un gruppo condiviso serve un account, così il gruppo sa chi sei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar em um grupo compartilhado exige uma conta, para que o grupo saiba quem você é."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा समूह में शामिल होने के लिए खाता चाहिए, ताकि समूह जान सके कि आप कौन हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有グループに参加するにはアカウントが必要です。グループがあなたを識別できるようにするためです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入共享群组需要账户，这样群组才知道你是谁。"
          }
        }
      }
    },
    "Keeps everything on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva todo en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve tout sur ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält alles auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tutto su questo telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém tudo neste telefone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी फ़ोन पर रखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末に残します。"
