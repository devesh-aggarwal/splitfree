    "Add a few expenses and this fills in with where your money goes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade algunos gastos y aquí verás a dónde va tu dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez quelques dépenses et vous verrez ici où part votre argent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein paar Ausgaben hinzu und du siehst hier, wohin dein Geld fließt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche spesa e qui vedrai dove vanno i tuoi soldi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione algumas despesas e aqui você verá para onde vai seu dinheiro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ खर्च जोड़ें और यहाँ दिखेगा कि आपका पैसा कहाँ जा रहा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出をいくつか追加すると、お金の行き先がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加几笔支出，这里就会显示你的钱花在了哪里。"
          }
        }
      }
    },
