    "The full version, including what is stored, for how long, and how to delete it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Fassung: was gespeichert wird, wie lange, und wie du es löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión completa: qué se guarda, durante cuánto tiempo y cómo borrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version complète : ce qui est stocké, pendant combien de temps, et comment le supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा संस्करण: क्या संग्रहीत होता है, कितने समय तक, और उसे कैसे हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione completa: cosa viene conservato, per quanto tempo e come cancellarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存される内容、保存期間、削除方法を含む完全版です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão completa: o que é armazenado, por quanto tempo e como apagar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整版本，包括存储了什么、保存多久，以及如何删除。"
          }
        }
      }
    },
