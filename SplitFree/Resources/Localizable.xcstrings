    "Add each line from the bill, then tap the people who shared it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cada línea de la cuenta y toca a quienes la compartieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez chaque ligne de l'addition, puis touchez les personnes qui l'ont partagée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge jede Position der Rechnung hinzu und tippe auf die Personen, die sie geteilt haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ogni riga del conto, poi tocca le persone che l'hanno condivisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cada linha da conta e toque nas pessoas que dividiram."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल की हर लाइन जोड़ें, फिर उन लोगों पर टैप करें जिन्होंने उसे साझा किया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
