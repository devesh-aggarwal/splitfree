    "Every expense, payment and group change shows up here as a running history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Ausgabe, Zahlung und Gruppenänderung erscheint hier als fortlaufender Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gasto, pago y cambio de grupo aparece aquí como un historial continuo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dépense, paiement et changement de groupe apparaît ici sous forme d'historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खर्च, भुगतान और समूह में हुआ बदलाव यहाँ लगातार इतिहास के रूप में दिखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni spesa, pagamento e modifica al gruppo compare qui come cronologia continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出・支払い・グループの変更が、ここに履歴として並びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada despesa, pagamento e mudança de grupo aparece aqui como um histórico contínuo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一笔支出、付款和群组变动都会作为流水记录显示在这里。"
          }
        }
      }
    },
    "Every group is square. Enjoy it while it lasts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gruppen sind ausgeglichen. Genieß es, solange es hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los grupos están saldados. Disfrútalo mientras dure."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les groupes sont à l'équilibre. Profitez-en."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर समूह का हिसाब बराबर है। जब तक चले, मज़े लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i gruppi sono in pari. Goditelo finché dura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのグループも精算済みです。この状態を楽しみましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os grupos estão quites. Aproveite enquanto dura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有群组都已结清，好好享受这一刻。"
          }
        }
      }
    },
    "Every group still has an open balance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gruppen haben noch einen offenen Saldo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los grupos tienen aún un saldo pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les groupes ont encore un solde en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर समूह में अभी हिसाब बाकी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i gruppi hanno ancora un saldo aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのグループにもまだ未精算の残高があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os grupos ainda têm saldo em aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个群组都还有未结清的余额。"
          }
        }
      }
    },
    "Every group, expense, payment and friend will be deleted from this device. This can't be undone — export a CSV first if you want a copy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gruppen, Ausgaben, Zahlungen und Freunde werden von diesem Gerät gelöscht. Das lässt sich nicht rückgängig machen – exportiere vorher eine CSV, wenn du eine Kopie möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de este dispositivo todos los grupos, gastos, pagos y amigos. No se puede deshacer: exporta un CSV antes si quieres una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les groupes, dépenses, paiements et amis seront supprimés de cet appareil. C'est irréversible : exportez un CSV avant si vous voulez une copie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से हर समूह, खर्च, भुगतान और दोस्त हट जाएँगे। इसे वापस नहीं लाया जा सकता — कॉपी चाहिए तो पहले CSV निर्यात कर लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i gruppi, le spese, i pagamenti e gli amici verranno eliminati da questo dispositivo. Non si può annullare: esporta prima un CSV se vuoi una copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末からすべてのグループ・支出・支払い・友だちが削除されます。取り消せません。控えが必要なら先にCSVを書き出してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os grupos, despesas, pagamentos e amigos serão excluídos deste dispositivo. Não dá para desfazer: exporte um CSV antes se quiser uma cópia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备上的所有群组、支出、付款和好友都会被删除，且无法撤销。若想留底，请先导出 CSV。"
          }
        }
      }
    },
