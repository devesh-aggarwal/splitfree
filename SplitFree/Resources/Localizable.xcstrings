    "No subscription, no paid tier": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción ni versión de pago"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni abonnement ni version payante"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo, keine Bezahlversion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento, nessuna versione a pagamento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura, sem versão paga"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न सदस्यता, न कोई सशुल्क संस्करण"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクも有料版もなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有订阅，没有付费版"
          }
        }
      }
    },
    "No subscription, no upgrade screen, no adverts, no limits on expenses, and nothing held back for a paid tier. Groups stay on your device unless you choose to share one with a friend.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción, sin pantalla de mejora, sin anuncios, sin límites de gastos y nada reservado para un plan de pago. Los grupos permanecen en tu dispositivo salvo que elijas compartir alguno con un amigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'abonnement, pas d'écran de mise à niveau, pas de publicité, pas de limite de dépenses et rien réservé à une offre payante. Les groupes restent sur votre appareil, sauf si vous choisissez d'en partager un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo, kein Upgrade-Bildschirm, keine Werbung, keine Ausgabenlimits und nichts, was einer Bezahlstufe vorbehalten wäre. Gruppen bleiben auf deinem Gerät, außer du teilst eine mit jemandem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento, nessuna schermata di upgrade, nessuna pubblicità, nessun limite alle spese e niente riservato a un piano a pagamento. I gruppi restano sul tuo dispositivo, a meno che tu non scelga di condividerne uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura, sem tela de upgrade, sem anúncios, sem limite de despesas e nada reservado para um plano pago. Os grupos ficam no seu aparelho, a menos que você escolha compartilhar algum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सदस्यता नहीं, कोई अपग्रेड स्क्रीन नहीं, कोई विज्ञापन नहीं, खर्चों की कोई सीमा नहीं, और कुछ भी भुगतान वाले स्तर के लिए रोका नहीं गया। जब तक आप किसी समूह को साझा न करें, समूह आपके डिवाइस पर ही रहते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションもアップグレード画面も広告もなく、支出の上限もなく、有料プランのために隠している機能もありません。友達と共有しない限り、グループは端末に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有订阅，没有升级页面，没有广告，支出没有上限，也没有任何功能留给付费档位。除非你选择把某个群组分享给朋友，否则群组都留在你的设备上。"
          }
        }
      }
    },
    "No subscription, no upgrade screen, no adverts, no limits on expenses, and nothing held back for a paid tier. Your data stays on your device and in your own iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción, sin pantalla de mejora, sin anuncios, sin límite de gastos y sin nada reservado para una versión de pago. Tus datos se quedan en tu dispositivo y en tu propio iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'abonnement, pas d'écran de mise à niveau, pas de publicité, pas de limite de dépenses et rien de réservé à une version payante. Vos données restent sur votre appareil et dans votre propre iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo, kein Upgrade-Bildschirm, keine Werbung, keine Begrenzung der Ausgaben und nichts, was einer Bezahlversion vorbehalten wäre. Deine Daten bleiben auf deinem Gerät und in deiner eigenen iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento, nessuna schermata di upgrade, nessuna pubblicità, nessun limite alle spese e niente riservato a una versione a pagamento. I tuoi dati restano sul tuo dispositivo e nel tuo iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura, sem tela de upgrade, sem anúncios, sem limite de despesas e nada guardado para uma versão paga. Seus dados ficam no seu dispositivo e no seu próprio iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सदस्यता नहीं, कोई अपग्रेड स्क्रीन नहीं, कोई विज्ञापन नहीं, खर्चों की कोई सीमा नहीं, और कुछ भी सशुल्क संस्करण के लिए रोका नहीं गया। आपका डेटा आपके डिवाइस और आपके अपने iCloud में ही रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションもアップグレード画面も広告もなく、支出の件数制限も、有料版のために隠された機能もありません。データはあなたの端末と、あなた自身のiCloudにとどまります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有订阅，没有升级页面，没有广告，支出笔数不设上限，也没有任何功能被留给付费版。你的数据只存放在你的设备和你自己的 iCloud 里。"
          }
        }
      }
    },
