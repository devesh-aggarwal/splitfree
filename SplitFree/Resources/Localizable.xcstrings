    "Tax and tip are shared in proportion to what each person ordered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer und Trinkgeld werden im Verhältnis zum Bestellten aufgeteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los impuestos y la propina se reparten en proporción a lo que pidió cada persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taxes et le pourboire sont répartis au prorata de ce que chacun a commandé."
