    "We send a six-digit code. There's no password to forget.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos un código de seis dígitos. No hay contraseña que olvidar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous envoyons un code à six chiffres. Aucun mot de passe à retenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden einen sechsstelligen Code. Es gibt kein Passwort, das du vergessen könntest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviamo un codice di sei cifre. Nessuna password da dimenticare."
          }
        },
        "pt-BR": {
