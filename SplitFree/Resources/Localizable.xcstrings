    "You'll join as %@, so the expenses already recorded against that name become yours.": {
      "extractionState": "manual",
      "comment": "Member name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te unirás como %@, así que los gastos ya registrados con ese nombre pasarán a ser tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rejoindrez en tant que %@, donc les dépenses déjà enregistrées sous ce nom deviendront les vôtres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trittst als %@ bei, sodass die bereits unter diesem Namen erfassten Ausgaben deine werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti unirai come %@, quindi le spese già registrate con quel nome diventeranno tue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrará como %@, então as despesas já registradas com esse nome passam a ser suas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ के रूप में शामिल होंगे, इसलिए उस नाम पर पहले से दर्ज खर्च आपके हो जाएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ として参加するため、その名前ですでに記録されている支出があなたのものになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将以 %@ 的身份加入，因此已经记在该名下的支出会变成你的。"
          }
        }
      }
    },
