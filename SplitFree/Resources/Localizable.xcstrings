    "Your groups stay on this phone, shared ones included. They stop receiving your friends' changes until you sign back in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gruppen bleiben auf diesem Gerät, auch die geteilten. Sie erhalten keine Änderungen deiner Freunde mehr, bis du dich wieder anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grupos permanecen en este teléfono, también los compartidos. Dejarán de recibir los cambios de tus amigos hasta que vuelvas a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos groupes restent sur ce téléphone, y compris les groupes partagés. Ils cessent de recevoir les modifications de vos amis jusqu'à votre reconnexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके समूह इसी फ़ोन पर रहेंगे, साझा किए गए भी। जब तक आप दोबारा साइन इन नहीं करते, उन्हें मित्रों के बदलाव मिलना बंद हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi gruppi restano su questo telefono, compresi quelli condivisi. Smettono di ricevere le modifiche dei tuoi amici finché non accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有中のものも含め、グループはこの端末に残ります。再びサインインするまで、友達の変更は届かなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus grupos ficam neste telefone, inclusive os compartilhados. Eles param de receber as mudanças dos seus amigos até você entrar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括共享的群组在内，你的群组都会留在这台手机上。在你重新登录之前，它们不再接收朋友的更改。"
          }
        }
      }
    },
