    "Track shared expenses with friends, flatmates and travel companions. Everyone's balance stays exact, down to the last cent.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los gastos compartidos con amigos, compañeros de piso y de viaje. El saldo de cada persona queda exacto, hasta el último céntimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les dépenses partagées avec vos amis, colocataires et compagnons de voyage. Le solde de chacun reste exact, au centime près."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte gemeinsame Ausgaben mit Freunden, Mitbewohnern und Reisebegleitung im Blick. Die Salden bleiben exakt, bis auf den letzten Cent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia delle spese condivise con amici, coinquilini e compagni di viaggio. Il saldo di ognuno resta esatto, fino all'ultimo centesimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe despesas compartilhadas com amigos, colegas de apartamento e companheiros de viagem. O saldo de cada um fica exato, até o último centavo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों, रूममेट्स और सफ़र के साथियों के साथ साझा खर्चों का हिसाब रखें। हर किसी का हिसाब आखिरी पैसे तक सटीक रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だち、ルームメイト、旅の仲間との共同の支出を記録します。全員の残高が1円単位までぴったり合います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你和朋友、室友、旅伴之间的共同支出。每个人的余额都精确到分。"
          }
        }
      }
    },
