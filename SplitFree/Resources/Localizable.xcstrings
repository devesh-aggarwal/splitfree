    "Give at least one person a share.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib mindestens einer Person einen Anteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna al menos una parte a alguien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez au moins une part à quelqu'un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक व्यक्ति को हिस्सा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna almeno una quota a qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも1人に口数を割り当ててください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê pelo menos uma cota a alguém."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少给一个人分配份额。"
          }
        }
      }
    },
    "Give each person a number of shares. Someone with 2 shares pays twice as much as someone with 1.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jeder Person eine Anzahl Anteile. Wer 2 Anteile hat, zahlt doppelt so viel wie jemand mit 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna a cada persona un número de partes. Quien tenga 2 partes paga el doble que quien tenga 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez un nombre de parts à chaque personne. Une personne avec 2 parts paie deux fois plus qu'une personne avec 1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर व्यक्ति को हिस्सों की संख्या दें। 2 हिस्से वाला 1 हिस्से वाले से दोगुना देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a ogni persona un numero di quote. Chi ha 2 quote paga il doppio di chi ne ha 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各自に口数を割り当てます。2口の人は1口の人の2倍を負担します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a cada pessoa um número de cotas. Quem tem 2 cotas paga o dobro de quem tem 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给每个人分配份额数。2 份的人要付 1 份的人的两倍。"
          }
        }
      }
    },
    "Give each person a percentage. Must add up to 100%.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jeder Person einen Prozentsatz. Die Summe muss 100 % ergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un porcentaje a cada persona. Debe sumar 100 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez un pourcentage à chaque personne. Le total doit faire 100 %."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर व्यक्ति को प्रतिशत दें। जोड़ 100% होना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna una percentuale a ogni persona. La somma deve fare 100%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各自に割合を指定します。合計が100%になる必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma porcentagem a cada pessoa. A soma precisa dar 100%."
          }
