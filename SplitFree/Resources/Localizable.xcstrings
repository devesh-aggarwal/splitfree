            "value": "उनका नाम"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il loro nome"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の名前"
          }
        },
        "pt-BR": {
          "stringUnit": {
