    "Once they accept, expenses between the two of you appear on both phones and your balance stays in step. Your groups are separate and stay where they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald sie annehmen, erscheinen Ausgaben zwischen euch auf beiden Geräten und euer Saldo bleibt im Gleichschritt. Deine Gruppen sind davon getrennt und bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando acepten, los gastos entre vosotros aparecerán en ambos teléfonos y vuestro saldo se mantendrá sincronizado. Tus grupos van aparte y se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois qu'ils acceptent, les dépenses entre vous deux apparaissent sur les deux téléphones et votre solde reste synchronisé. Vos groupes sont distincts et ne bougent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब वे स्वीकार कर लेंगे, आप दोनों के बीच के खर्च दोनों फ़ोन पर दिखेंगे और आपका बैलेंस एक जैसा रहेगा। आपके समूह अलग हैं और अपनी जगह रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando accettano, le spese tra voi due compaiono su entrambi i telefoni e il vostro saldo resta allineato. I tuoi gruppi sono separati e restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が承諾すると、二人の間の支出が両方の端末に表示され、残高が同期されます。グループはこれとは別で、そのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aceitarem, as despesas entre vocês dois aparecem nos dois telefones e o saldo fica em sincronia. Seus grupos são separados e continuam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方接受后，你们之间的支出会同时出现在两台手机上，余额保持一致。你的群组是独立的，不受影响。"
          }
        }
      }
    },
    "Once they join, what the two of you share stays in step on both phones.": {
      "comment": "A description of how a friend's invitation is shared.",
      "isCommentAutoGenerated": true
    },
    "Only people in this group can be part of the expense.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Personen aus dieser Gruppe können an der Ausgabe beteiligt sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas de este grupo pueden participar en el gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les personnes de ce groupe peuvent participer à la dépense."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खर्च में सिर्फ़ इसी समूह के लोग शामिल हो सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone di questo gruppo possono partecipare alla spesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支出に参加できるのはグループのメンバーだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas deste grupo podem participar da despesa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这个群组里的人才能参与这笔支出。"
          }
        }
      }
    },
    "Open the group": {
