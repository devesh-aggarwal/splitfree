    "No line items were recognized. The photo will still be attached — you can add the items by hand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Positionen erkannt. Das Foto wird trotzdem angehängt – du kannst die Positionen von Hand eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha reconocido ninguna línea. La foto se adjuntará igualmente: puedes añadir los artículos a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ligne n'a été reconnue. La photo sera tout de même jointe : vous pouvez ajouter les articles à la main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आइटम पहचाना नहीं गया। फ़ोटो फिर भी जुड़ जाएगी — आप आइटम खुद जोड़ सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata riconosciuta nessuna voce. La foto verrà comunque allegata: puoi aggiungere le voci a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "品目を読み取れませんでした。写真は添付されるので、品目は手入力できます。"
