        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas numériser de documents. Vous pouvez tout de même joindre une photo du reçu et saisir les articles vous-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann keine Dokumente scannen. Du kannst trotzdem ein Foto des Belegs anhängen und die Positionen selbst eintragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può scansionare documenti. Puoi comunque allegare una foto dello scontrino e inserire le voci a mano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não digitaliza documentos. Você ainda pode anexar uma foto do recibo e adicionar os itens à mão."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस दस्तावेज़ स्कैन नहीं कर सकता। आप फिर भी रसीद की फ़ोटो जोड़कर आइटम खुद डाल सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末は書類をスキャンできません。レシートの写真を添付して、品目を手入力することはできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法扫描文稿。你仍可以附上小票照片并手动添加条目。"
          }
        }
      }
    },
    "This group goes back to being local to your phone. It stays on the server for everyone else you invited, and their copies keep working.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo vuelve a ser local en tu teléfono. Sigue en el servidor para el resto de personas que invitaste, y sus copias siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe redevient local à votre téléphone. Il reste sur le serveur pour les autres personnes invitées, dont les copies continuent de fonctionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe wird wieder lokal auf deinem Gerät. Für alle anderen, die du eingeladen hast, bleibt sie auf dem Server, und ihre Kopien funktionieren weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo torna a essere locale sul tuo telefono. Resta sul server per tutte le altre persone che hai invitato e le loro copie continuano a funzionare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo volta a ser local no seu telefone. Ele continua no servidor para as outras pessoas que você convidou, e as cópias delas seguem funcionando."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समूह फिर से केवल आपके फ़ोन पर रह जाएगा। आपने जिन्हें आमंत्रित किया था उनके लिए यह सर्वर पर बना रहेगा और उनकी प्रतियाँ काम करती रहेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループはあなたの端末だけのものに戻ります。招待した他の人のためにサーバー上には残り、その人たちの控えは引き続き使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组会重新变为仅存在于你的手机上。对于你邀请的其他人，它仍保留在服务器上，他们的副本继续可用。"
          }
        }
      }
    },
