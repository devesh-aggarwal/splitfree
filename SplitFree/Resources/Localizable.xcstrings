    "Add a few expenses and this fills in with where your money goes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein paar Ausgaben hinzu und du siehst hier, wohin dein Geld fließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade algunos gastos y aquí verás a dónde va tu dinero."
