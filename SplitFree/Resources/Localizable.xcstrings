    "Tax and tip are shared in proportion to what each person ordered.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los impuestos y la propina se reparten en proporción a lo que pidió cada persona."
          }
        },
