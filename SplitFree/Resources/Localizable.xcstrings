    "Recorded as yours alone — useful for tracking your own spending.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se registra solo a tu nombre: útil para controlar tu propio gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré à votre seul nom : pratique pour suivre vos propres dépenses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur dir zugerechnet – praktisch, um die eigenen Ausgaben im Blick zu behalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrata solo a tuo nome: utile per tenere traccia delle tue spese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrada só no seu nome: útil para acompanhar seus próprios gastos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपके नाम दर्ज होगा — अपने खर्च पर नज़र रखने के लिए उपयोगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
