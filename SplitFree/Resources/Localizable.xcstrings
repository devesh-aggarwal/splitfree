    },
    "Keeps your ledger on all your devices. Takes effect next launch.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus cuentas en todos tus dispositivos. Se aplica al reiniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde vos comptes sur tous vos appareils. Prend effet au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deine Abrechnungen auf allen Geräten aktuell. Wirkt beim nächsten Start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene i tuoi conti su tutti i dispositivi. Ha effetto al prossimo avvio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém suas contas em todos os seus dispositivos. Vale a partir da próxima abertura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हिसाब आपके सभी डिवाइस पर रखता है। अगली बार ऐप खोलने पर लागू होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての端末で記録を同期します。次回起動時から有効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的所有设备上同步账目。下次启动后生效。"
          }
        }
      }
    },
