    "Your totals are shown in this currency. Individual expenses can still be in any of 150+ currencies.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Summen werden in dieser Währung angezeigt. Einzelne Ausgaben können weiterhin in über 150 Währungen erfasst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus totales se muestran en esta moneda. Cada gasto puede seguir estando en cualquiera de más de 150 monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos totaux s'affichent dans cette devise. Chaque dépense peut rester dans l'une des plus de 150 devises."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कुल इसी मुद्रा में दिखाए जाते हैं। अलग-अलग खर्च अब भी 150+ मुद्राओं में से किसी में भी हो सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi totali sono mostrati in questa valuta. Le singole spese possono comunque essere in una qualsiasi di oltre 150 valute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計はこの通貨で表示されます。個々の支出は150以上の通貨から選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus totais são exibidos nesta moeda. Cada despesa ainda pode estar em qualquer uma de mais de 150 moedas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总额以此货币显示。单笔支出仍可使用 150 多种货币中的任意一种。"
          }
        }
      }
    },
